<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/surfaceDark"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/spacing_xl"
        android:background="?attr/surfaceMedium">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="应用到图片"
            android:textColor="?attr/textPrimary"
            android:textSize="@dimen/text_xxl"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_xxl">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="选择图片"
                android:textColor="?attr/textTertiary"
                android:textSize="@dimen/text_body_xl"
                android:paddingBottom="@dimen/spacing_md" />

            <FrameLayout
                android:id="@+id/imageArea"
                android:layout_width="match_parent"
                android:layout_height="@dimen/upload_area_height_large"
                android:background="@drawable/image_upload_border"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless">

                <LinearLayout
                    android:id="@+id/imagePlaceholder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="@dimen/icon_size_large"
                        android:layout_height="@dimen/icon_size_large"
                        android:src="@drawable/ic_add_image" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="点击选择图片"
                        android:textColor="?attr/textDisabled"
                        android:textSize="@dimen/text_body_xl"
                        android:layout_marginTop="@dimen/spacing_md" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/imagePreview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="选择滤镜"
                android:textColor="?attr/textTertiary"
                android:textSize="@dimen/text_body_xl"
                android:paddingTop="@dimen/spacing_xl"
                android:paddingBottom="@dimen/spacing_md" />

            <Spinner
                android:id="@+id/filterSpinner"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:background="?attr/surfaceLight"
                android:paddingHorizontal="@dimen/spacing_lg" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApply"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/spacing_xxl"
                android:text="应用"
                android:enabled="false"
                style="@style/Widget.ClassicCamera.Button"
                android:backgroundTint="?attr/accentColor" />

            <TextView
                android:id="@+id/tvResultLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="效果预览"
                android:textColor="?attr/textTertiary"
                android:textSize="@dimen/text_body_xl"
                android:paddingTop="@dimen/spacing_xl"
                android:paddingBottom="@dimen/spacing_md"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/spacing_xl"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/resultImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/spacing_xxl"
                android:text="保存到相册"
                android:visibility="gone"
                style="@style/Widget.ClassicCamera.Button"
                android:backgroundTint="?attr/successColor" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
