<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/surfaceDark"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/spacing_xl"
        android:background="?attr/surfaceMedium">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="滤镜"
            android:textColor="?attr/textPrimary"
            android:textSize="@dimen/text_xxl"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvEmptyHint"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="暂无滤镜，点击下方「新建」开始学习"
        android:textColor="?attr/textTertiary"
        android:textSize="@dimen/text_body_xl"
        android:visibility="gone" />

    <ListView
        android:id="@+id/listFilters"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="?attr/dividerDark"
        android:dividerHeight="1dp"
        android:padding="@dimen/spacing_md" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="?attr/surfaceMedium"
        android:paddingHorizontal="@dimen/spacing_xxl"
        android:paddingVertical="@dimen/spacing_md">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApplyFilter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="应用到图片"
            style="@style/Widget.ClassicCamera.Button"
            android:layout_marginEnd="@dimen/spacing_xs" />

        <Space
            android:layout_width="@dimen/spacing_md"
            android:layout_height="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNewFilter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="新建"
            style="@style/Widget.ClassicCamera.Button"
            android:layout_marginStart="@dimen/spacing_xs" />
    </LinearLayout>

</LinearLayout>
