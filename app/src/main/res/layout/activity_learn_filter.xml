<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/surfaceDark"
    android:fitsSystemWindows="true">

    <!-- 标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/spacing_xl"
        android:background="?attr/surfaceMedium">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="学习滤镜"
            android:textColor="?attr/textPrimary"
            android:textSize="@dimen/text_xxl"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 原图上传区域 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=" 原图"
        android:textColor="?attr/textTertiary"
        android:textSize="@dimen/text_body_xl"
        android:paddingHorizontal="@dimen/spacing_xxl"
        android:paddingTop="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_sm" />

    <FrameLayout
        android:id="@+id/originalImageArea"
        android:layout_width="match_parent"
        android:layout_height="@dimen/upload_area_height"
        android:layout_marginHorizontal="@dimen/spacing_xxl"
        android:background="@drawable/image_upload_border"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless">

        <LinearLayout
            android:id="@+id/originalPlaceholder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="@dimen/icon_size_large"
                android:layout_height="@dimen/icon_size_large"
                android:src="@drawable/ic_add_image" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="点击选择原图"
                android:textColor="?attr/textDisabled"
                android:textSize="@dimen/text_body_xl"
                android:layout_marginTop="@dimen/spacing_md" />
        </LinearLayout>

        <ImageView
            android:id="@+id/originalPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 滤镜图上传区域 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=" 滤镜图"
            android:textColor="?attr/textTertiary"
        android:textSize="@dimen/text_body_xl"
        android:paddingHorizontal="@dimen/spacing_xxl"
        android:paddingTop="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_sm" />

    <FrameLayout
        android:id="@+id/filterImageArea"
        android:layout_width="match_parent"
        android:layout_height="@dimen/upload_area_height"
        android:layout_marginHorizontal="@dimen/spacing_xxl"
        android:background="@drawable/image_upload_border"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless">

        <LinearLayout
            android:id="@+id/filterPlaceholder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="@dimen/icon_size_large"
                android:layout_height="@dimen/icon_size_large"
                android:src="@drawable/ic_add_image" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="点击选择滤镜图"
                android:textColor="?attr/textDisabled"
                android:textSize="@dimen/text_body_xl"
                android:layout_marginTop="@dimen/spacing_md" />
        </LinearLayout>

        <ImageView
            android:id="@+id/filterPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 拟合方式下拉 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/spacing_xxl"
        android:paddingTop="@dimen/spacing_lg"
        android:paddingBottom="@dimen/spacing_xs">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="拟合方式"
        android:textColor="?attr/textSecondary"
        android:textSize="@dimen/text_body_xl" />

    <Spinner
        android:id="@+id/spFitMethod"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/spacing_lg"
            android:backgroundTint="?attr/accentColor"
            android:popupBackground="?attr/surfaceLight" />
    </LinearLayout>

    <!-- 说明文字 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="请选择一张原图和一张原图加上滤镜之后的图片，本次学习将学习到这个滤镜效果"
        android:textColor="?attr/textSecondary"
        android:textSize="@dimen/text_body_lg"
        android:paddingHorizontal="@dimen/spacing_xxl"
        android:paddingTop="@dimen/spacing_xs"
        android:paddingBottom="@dimen/spacing_xs" />

    <!-- 覆盖率和滤镜名称 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/spacing_xxl"
        android:paddingVertical="@dimen/spacing_md">

        <TextView
            android:id="@+id/tvCoverage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=""
        android:textColor="?attr/textTertiary"
            android:textSize="@dimen/text_body_xl" />
    </LinearLayout>

    <!-- 底部按钮栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_height"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="?attr/surfaceMedium"
        android:paddingHorizontal="@dimen/spacing_xxl"
        android:paddingVertical="@dimen/spacing_md">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddImages"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="添加图片"
            android:enabled="false"
            style="@style/Widget.ClassicCamera.Button.Secondary"
            android:paddingHorizontal="@dimen/spacing_md" />

        <Space
            android:layout_width="@dimen/spacing_md"
            android:layout_height="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartLearn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="开始学习"
            android:enabled="false"
            style="@style/Widget.ClassicCamera.Button.Secondary"
            android:paddingHorizontal="@dimen/spacing_md" />

        <Space
            android:layout_width="@dimen/spacing_md"
            android:layout_height="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFinishLearn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="完成"
            android:enabled="false"
            style="@style/Widget.ClassicCamera.Button.Secondary"
            android:paddingHorizontal="@dimen/spacing_md" />
    </LinearLayout>

</LinearLayout>
