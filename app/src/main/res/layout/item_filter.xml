<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/spacing_xl"
    android:paddingEnd="@dimen/spacing_xs"
    android:background="?attr/surfaceMedium">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvFilterName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="?attr/textPrimary"
        android:textSize="@dimen/text_xl" />

    <TextView
        android:id="@+id/tvFilterSize"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?attr/textTertiary"
        android:textSize="@dimen/text_body"
        android:layout_marginEnd="@dimen/spacing_md" />

    <TextView
        android:id="@+id/btnVisualize"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:gravity="center"
        android:text="◎"
        android:textColor="?attr/accentColor"
        android:textSize="@dimen/text_body_xl"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:visibility="gone" />

    <TextView
        android:id="@+id/btnDelete"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:gravity="center"
        android:text="✕"
        android:textColor="?attr/errorColor"
        android:textSize="@dimen/text_xl"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:visibility="gone" />

</LinearLayout>
