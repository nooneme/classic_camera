<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface_darkest">

    <!-- 顶部 spacer：吸收剩余空间，将内容推到底部 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/surface_darkest" />

    <!-- 预览区：GLSurfaceView + 对焦指示器叠加层 -->
    <FrameLayout
        android:id="@+id/previewContainer"
        android:layout_width="match_parent"
        android:layout_height="@dimen/preview_height"
        android:layout_marginTop="@dimen/spacing_xxl">

        <android.opengl.GLSurfaceView
            android:id="@+id/glSurfaceView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:id="@+id/focusIndicator"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/focus_rect"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 实时状态栏：快门 / ISO / 滤镜 -->
    <LinearLayout
        android:id="@+id/statusBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/spacing_xl"
        android:paddingVertical="@dimen/spacing_xs"
        android:background="@color/surface_medium">

        <TextView
            android:id="@+id/tvStatusShutter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="快门 --"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/tvStatusIso"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ISO --"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvStatusFilter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="滤镜: 无"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body"
            android:gravity="end"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- 手动控制栏：快门速度 + ISO -->
    <LinearLayout
        android:id="@+id/manualControlBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/spacing_lg"
        android:paddingVertical="@dimen/spacing_xxs"
        android:background="@color/surface_dark">

        <!-- 左半：快门速度 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="快门 "
                    android:textColor="@color/text_tertiary"
                    android:textSize="@dimen/text_sm" />

                <TextView
                    android:id="@+id/tvShutterSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Auto"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body_lg"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/sbShutterSpeed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-8dp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="28dp"
            android:background="@color/divider"
            android:layout_marginHorizontal="@dimen/spacing_lg" />

        <!-- 右半：ISO -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ISO "
                    android:textColor="@color/text_tertiary"
                    android:textSize="@dimen/text_sm" />

                <TextView
                    android:id="@+id/tvIso"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Auto"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body_lg"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/sbIso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-8dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 快门按钮栏（Material Design 风格） -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="@dimen/spacing_sm"
        android:background="@color/surface_medium">

        <ImageButton
            android:id="@+id/btnLastPhoto"
            android:layout_width="@dimen/widget_size"
            android:layout_height="@dimen/widget_size"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="@dimen/spacing_xxxl"
            android:src="@drawable/ic_filter"
            android:background="@drawable/btn_icon_md_bg"
            android:scaleType="center"
            android:contentDescription="滤镜" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShutter"
            style="@style/Widget.Material3.Button.ElevatedButton"
            android:layout_width="@dimen/shutter_size"
            android:layout_height="@dimen/shutter_size"
            android:layout_gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            app:cornerRadius="36dp"
            app:backgroundTint="@color/shutter_inner"
            app:strokeWidth="0dp"
            app:rippleColor="@color/overlay_light"
            android:contentDescription="拍照" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="@dimen/widget_size"
            android:layout_height="@dimen/widget_size"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="@dimen/spacing_xxxl"
            android:src="@drawable/ic_settings_gear"
            android:background="@drawable/btn_icon_md_bg"
            android:scaleType="center"
            android:contentDescription="设置" />
    </FrameLayout>

    <!-- LUT 选择栏 -->
    <LinearLayout
        android:id="@+id/lutSelectorBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/spacing_md"
        android:paddingVertical="@dimen/spacing_xs"
        android:background="@color/surface_dark">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/lutRecyclerView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingEnd="@dimen/spacing_xs" />

        <ImageButton
            android:id="@+id/btnManageFilters"
            android:layout_width="@dimen/widget_size"
            android:layout_height="@dimen/widget_size"
            android:src="@drawable/ic_settings_gear"
            android:scaleType="center"
            android:background="@drawable/btn_icon_md_bg"
            android:contentDescription="管理滤镜"
            android:layout_marginStart="@dimen/spacing_xs" />
    </LinearLayout>

    <!-- 底部镜头按钮栏 -->
    <HorizontalScrollView
        android:id="@+id/lensScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/spacing_xs"
        android:background="@color/surface_medium">

        <LinearLayout
            android:id="@+id/lensButtonBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/spacing_xs" />
    </HorizontalScrollView>

</LinearLayout>
