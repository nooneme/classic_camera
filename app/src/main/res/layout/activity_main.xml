<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- 预览区：GLSurfaceView + 对焦指示器叠加层 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="60dp">

        <android.opengl.GLSurfaceView
            android:id="@+id/glSurfaceView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:id="@+id/focusIndicator"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/focus_rect"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 实时状态栏：快门 / ISO / 滤镜 -->
    <LinearLayout
        android:id="@+id/statusBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="4dp"
        android:background="#222222">

        <TextView
            android:id="@+id/tvStatusShutter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="快门 --"
            android:textColor="#CCCCCC"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvStatusIso"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ISO --"
            android:textColor="#CCCCCC"
            android:textSize="12sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvStatusFilter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="滤镜: 无"
            android:textColor="#CCCCCC"
            android:textSize="12sp"
            android:gravity="end"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- 手动控制栏：快门速度 + ISO（滑到最左 = Auto，过段落线 = 手动） -->
    <LinearLayout
        android:id="@+id/manualControlBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:background="#1a1a1a">

        <!-- 左半：快门速度 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="快门 "
                    android:textColor="#888888"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvShutterSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Auto"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/sbShutterSpeed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="14"
                android:progressDrawable="@drawable/seekbar_track_detent"
                android:splitTrack="false" />
        </LinearLayout>

        <!-- 段落分隔线 -->
        <View
            android:layout_width="1dp"
            android:layout_height="28dp"
            android:background="#444444"
            android:layout_marginHorizontal="12dp" />

        <!-- 右半：ISO -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ISO "
                    android:textColor="#888888"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvIso"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Auto"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/sbIso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="9"
                android:progressDrawable="@drawable/seekbar_track_detent"
                android:splitTrack="false" />
        </LinearLayout>
    </LinearLayout>

    <!-- 快门按钮栏 + 设置入口 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="0dp"
        android:background="#222222">

        <!-- 最后照片按钮：快门左边与屏幕边缘的中间位置 -->
        <ImageButton
            android:id="@+id/btnLastPhoto"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="60dp"
            android:src="@drawable/ic_filter"
            android:background="@drawable/filter_btn_bg"
            android:scaleType="center"
            android:contentDescription="滤镜" />

        <!-- 快门按钮居中 -->
        <ImageButton
            android:id="@+id/btnShutter"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:src="@null"
            android:background="@drawable/red_circle_shutter"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="拍照" />

        <!-- 设置按钮：快门右边与屏幕边缘的中间位置 -->
        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="60dp"
            android:src="@drawable/ic_settings_gear"
            android:background="@drawable/settings_gear_bg"
            android:scaleType="center"
            android:contentDescription="设置" />
    </FrameLayout>

    <!-- LUT 选择栏：横向滚动 -->
    <LinearLayout
        android:id="@+id/lutSelectorBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="3dp"
        android:background="#1A1A1A">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LUT"
            android:textColor="#888888"
            android:textSize="10sp"
            android:layout_marginEnd="6dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/lutRecyclerView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingEnd="4dp" />

        <ImageView
            android:id="@+id/btnManageFilters"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_settings_gear"
            android:scaleType="center"
            android:background="@drawable/settings_gear_bg"
            android:contentDescription="管理滤镜"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- 底部镜头按钮栏：横向滚动 -->
    <HorizontalScrollView
        android:id="@+id/lensScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="#222222">

        <LinearLayout
            android:id="@+id/lensButtonBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="2dp"
            android:paddingHorizontal="6dp" />
    </HorizontalScrollView>

</LinearLayout>
