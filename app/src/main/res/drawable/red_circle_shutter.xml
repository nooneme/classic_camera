<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="?attr/shutterOuter" />
            <size android:width="@dimen/shutter_size" android:height="@dimen/shutter_size" />
        </shape>
    </item>
    <item
        android:left="@dimen/shutter_ring"
        android:top="@dimen/shutter_ring"
        android:right="@dimen/shutter_ring"
        android:bottom="@dimen/shutter_ring">
        <shape android:shape="oval">
            <solid android:color="?attr/shutterInner" />
        </shape>
    </item>
</layer-list>
