    <!-- Dialog / Overlay 主题 -->
    <style name="Theme.CoverageDialog" parent="Theme.古法相机">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowMinWidthMajor">85%</item>
        <item name="android:windowMinWidthMinor">85%</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- ========== 通用组件样式（在布局中通过 style="@style/..." 使用） ========== -->

    <!-- MaterialButton -->
    <style name="Widget.ClassicCamera.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">?attr/accentColor</item>
        <item name="android:textColor">?attr/textPrimary</item>
        <item name="android:textSize">@dimen/text_body_xl</item>
        <item name="cornerRadius">@dimen/corner_medium</item>
    </style>

    <style name="Widget.ClassicCamera.Button.Secondary" parent="Widget.ClassicCamera.Button">
        <item name="backgroundTint">?attr/surfaceLight</item>
        <item name="android:textColor">?attr/textSecondary</item>
    </style>

    <!-- MaterialCardView -->
    <style name="Widget.ClassicCamera.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">?attr/surfaceCard</item>
        <item name="strokeColor">?attr/dividerColor</item>
        <item name="strokeWidth">@dimen/border_thin</item>
        <item name="cardCornerRadius">@dimen/corner_medium</item>
        <item name="contentPadding">@dimen/spacing_xs</item>
    </style>

    <!-- ShapeableImageView 圆角叠加层 -->
    <style name="ShapeAppearanceOverlay.ShapeableImageView.Corner" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_medium</item>
