<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Base.Theme.古法相机" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorPrimaryContainer">@color/accent_container</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_tertiary</item>
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/text_primary</item>
        <item name="android:statusBarColor">@color/surface_medium</item>
        <item name="android:navigationBarColor">@color/surface_dark</item>
        <item name="android:windowBackground">@color/surface_darkest</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.古法相机" parent="Base.Theme.古法相机" />

    <!-- Dialog / Overlay 主题 -->
    <style name="Theme.CoverageDialog" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowMinWidthMajor">85%</item>
        <item name="android:windowMinWidthMinor">85%</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- ========== 通用组件样式（在布局中通过 style="@style/..." 使用） ========== -->

    <!-- MaterialButton -->
    <style name="Widget.ClassicCamera.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_body_xl</item>
        <item name="cornerRadius">@dimen/corner_medium</item>
    </style>

    <style name="Widget.ClassicCamera.Button.Secondary" parent="Widget.ClassicCamera.Button">
        <item name="backgroundTint">@color/surface_light</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- MaterialCardView -->
    <style name="Widget.ClassicCamera.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface_card</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">@dimen/border_thin</item>
        <item name="cardCornerRadius">@dimen/corner_medium</item>
        <item name="contentPadding">@dimen/spacing_xs</item>
    </style>

    <!-- ShapeableImageView 圆角叠加层 -->
    <style name="ShapeAppearanceOverlay.ShapeableImageView.Corner" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_medium</item>
    </style>
</resources>
