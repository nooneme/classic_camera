<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 语义化颜色系统 - 浅色系: 奶白色 / 嫩黄色 / 淡蓝色 -->

    <!-- Surface 层级 -->
    <color name="surface_darkest">#FFF8F4EC</color>   <!-- 1. 主背景：奶白色 -->
    <color name="surface_dark">#FFFDF8F0</color>       <!-- 2. 次背景：暖白 -->
    <color name="surface_medium">#FFFFF8F0</color>      <!-- 3. 面板：米白 -->
    <color name="surface_light">#FFF0F5FF</color>       <!-- 4. 浅蓝白（按钮/卡片） -->
    <color name="surface_card">#FFFFFAF0</color>        <!-- 5. 卡片：近白 -->

    <!-- 文字层级（浅色背景用深色字） -->
    <color name="text_primary">#FF2C2C2C</color>       <!-- 主文字：近黑 -->
    <color name="text_secondary">#FF555555</color>      <!-- 次要文字 -->
    <color name="text_tertiary">#FF888888</color>       <!-- 辅助文字 -->
    <color name="text_disabled">#FFBBBBBB</color>       <!-- 禁用文字 -->

    <!-- 品牌色 / 强调色（淡蓝色） -->
    <color name="accent">#FF90CAF9</color>              <!-- 淡蓝主色 -->
    <color name="accent_dark">#FF64B5F6</color>         <!-- 稍深蓝 -->
    <color name="accent_container">#2290CAF9</color>    <!-- 淡蓝半透明 -->

    <!-- 功能色 -->
    <color name="error">#FFEF9A9A</color>               <!-- 柔红 -->
    <color name="error_container">#22EF9A9A</color>
    <color name="success">#FF81C784</color>             <!-- 柔绿 -->

    <!-- 快门按钮 -->
    <color name="shutter_outer">#FFDDDDDD</color>
    <color name="shutter_inner">#FFE57373</color>       <!-- 暖珊瑚红 -->

    <!-- 半透明白色（用于按钮背景遮罩） -->
    <color name="overlay_light">#44FFFFFF</color>
    <color name="overlay_dark">#22000000</color>        <!-- 浅半透明黑 -->

    <!-- 分隔线 / 边框（暖灰色） -->
    <color name="divider">#FFE0D8C8</color>
    <color name="divider_dark">#FFD0C8B8</color>

    <!-- 图库浅色主题 -->
    <color name="gallery_surface">#FFF8F4EC</color>
    <color name="gallery_surface_light">#FFFFF8F0</color>
    <color name="gallery_divider">#FFE0D8C8</color>

    <!-- Dialog -->
    <color name="dialog_scrim">#44000000</color>

    <!-- Vector 图标 -->
    <color name="icon_primary">#FF2C2C2C</color>
    <color name="icon_disabled">#FFBBBBBB</color>

    <!-- Black / White 保留兼容 -->
    <color name="black">#FF2C2C2C</color>
    <color name="white">#FFF8F4EC</color>
</resources>
